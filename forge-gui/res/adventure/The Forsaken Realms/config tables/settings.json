{
    // ============================================================================
    // The Forsaken Realms - game balance settings. Edit values, restart the game.
    // Comments (// lines) are supported by the game's JSON reader - leave them in.
    // Deleting this file resets everything to the built-in defaults.
    // ============================================================================

    // Real-world seconds per in-game day (at normal 1x speed). Lowered 400 -> 300 (2026-08-23
    // user request) - a shorter real-world day means the same in-game week/day milestones (the
    // weighted spawn tier system's week brackets included) arrive faster in wall-clock time.
    "dayLengthSeconds": 300.0,

    // Territory growth: how fast the player's Capitol claims land (tiles per day).
    "capitolExpansionTilesPerDay": 1,
    // Player towns earn 1 territory tile per this many days (higher = slower towns).
    "townExpansionDaysPerTile": 7,
    // How fast each AI color's castle claims land (tiles per day).
    "aiCastleExpansionTilesPerDay": 1,

    // Maximum territory radius (in tiles) a Capitol or AI castle can ever reach.
    "maxTerritoryRadius": 450,
    // Maximum territory radius for ordinary towns. Raised 20 -> 25 (2026-08-24) after the town-
    // count reduction to 50/color - fewer towns need to reach further to keep total map coverage
    // from shrinking. Freely retune this number directly - see townProtectedRadiusCap below for
    // why raising this alone no longer also grows a town's inviolable protected core.
    "townMaxTerritoryRadius": 450,
    // Cap on a town's PROTECTED core (rivals can never touch it), kept separate from the growth
    // cap above (2026-08-24 user spec: "increase how far... towns can grow... starting radius and
    // protected radius should stay unchanged"). Protected radius = min(currentRadius, this) / 2,
    // so pinning this at the ORIGINAL townMaxTerritoryRadius (20) keeps the protected core's
    // ceiling exactly what it is today (20/2=10) even as the outer territory disc now reaches to 25.
    "townProtectedRadiusCap": 20,

    // Game speed when the HUD "Speed-Up" toggle is on (multiplier over normal time).
    "speedUpMultiplier": 50.0,

    // Overworld walking-speed modifiers by whose land you are on (0.15 = 15%).
    // Your own land is a bonus; AI land depends on your reputation with that color.
    "playerTerritorySpeedBonus": 0.15,
    "aiTerritoryHappySpeedBonus": 0.05,
    "aiTerritoryPartnerSpeedBonus": 0.10,
    "aiTerritoryUnhappySpeedPenalty": 0.05,
    "aiTerritoryWarSpeedPenalty": 0.10,

    // What each built Mine pays out on payday (weekly, on days 7/14/21/28).
    "mineWeeklyGoldPayout": 100,
    "mineWeeklyWoodPayout": 25,
    "mineWeeklyStonePayout": 25,
    "mineWeeklyShardPayout": 20,

    // Ante re-roll: Shard cost of the first re-roll in a duel, and how much each
    // additional re-roll in the same duel multiplies the cost (1.5 = +50%).
    "anteRerollBaseShardCost": 10,
    "anteRerollEscalationRate": 1.5,
    // Ante buy-back price = this multiplier x the card's normal sell value...
    "anteBuyBackMultiplier": 1.5,
    // ...but never below these floors, by card rarity.
    "anteBuyBackMinCommon": 50,
    "anteBuyBackMinUncommon": 100,
    "anteBuyBackMinRare": 300,
    "anteBuyBackMinMythic": 500,

    // Maximum resource pickups (Gold/Wood/Stone/Shards/Mystery/Chest) on the world map at once.
    // Raised 30 -> 50 (2026-08-23 user request), then 50 -> 60 (2026-08-25, to make room for the
    // new Chest loot-spawn type without thinning out the original 5).
    "maxResourceSpawns": 60,

    // Card price multipliers: cards cost more in AI-owned towns, less in yours
    // (applied before reputation discounts/markups).
    "aiShopPriceMultiplier": 1.25,
    "playerShopPriceMultiplier": 0.75,

    // Days before a side quest fails after accepting it (story quests never expire).
    "sideQuestDays": 20,

    // How many attacking mages each AI color can field at once on Normal difficulty.
    // Easy uses one fewer, Hard one more, Insane two more (2 -> Easy 1 / Normal 2 /
    // Hard 3 / Insane 4 since round 125; it was 3 -> 2/3/4/5 before). Town-count and
    // Color Defeat bonuses stack on top of this base.
    "baseAttackingMagesPerColor": 2,

    // Round 239 - the AI answers the player's Capitol: +this many to every color's attacking-mage cap for as
    // long as the Capitol stands, and (capitolBuiltSendsMages) one mage from every color the moment it is built.
    "capitolBuiltMageCapBonus": 1,
    "capitolBuiltSendsMages": true,

    // Round 239 - legend sightings: how many times longer than an ordinary roamer (20 s of travel time) a
    // sighted frontier legend stays on the overworld before it fades. 1 = no change.
    "legendLifetimeFactor": 3,

    // Fraction of an edition's own card count you must have found before the Research
    // Lab offers to unlock it (e.g. 0.10 = 10%). Floored at 5 cards regardless of this
    // value, so a tiny supplemental set can't become a 1-2 card unlock.
    "researchThresholdFraction": 0.10,
    // Research Lab: in-game days from clicking Research until an edition unlocks. Each edition
    // runs on its own timer, so several can be in progress at once.
    "researchDays": 7,
    // Research Lab: base shard price per edition (difficulty scaling applies on top).
    "researchShardCost": 50,
    // AI towns: in-game days of unbroken AI ownership per guard-dot level (4 levels; the clock
    // starts when the town is first seen held, not retroactively). Level sets the assault defender:
    // none = Apprentice, 1 = Adept, 2 = Master, 3 = Archmage, 4 = Archmage with two starting lands.
    "aiTownGuardDaysPerLevel": 28,
    // A given AI town can be attacked once per this many in-game days; the guards' dialog says
    // how many days remain if you come back sooner.
    "aiTownAssaultCooldownDays": 7,
    // Town-assault defender life multiplier per difficulty [Easy, Normal, Hard, Insane], on top of
    // the usual difficulty enemy life factor.
    "townDefenderLifeFactorByDifficulty": [1.0, 1.5, 1.75, 2.0],
    // Reputation lost with the attacked color when you START an assault, and the extra loss when
    // you CAPTURE the town (allies lose half, that color's enemies gain the same).
    "townAssaultReputationPenalty": 4,
    "townCaptureReputationPenalty": 8,
    // Center Towns: you lose the game when a single AI color holds this many of the five star
    // towns around the campfire (new worlds only).
    "starTownsLossCount": 3,
    // Center Towns: no other town may generate within this many tiles of the campfire.
    "starTownExclusionRadiusTiles": 24,
    // Minimum distance (tiles) between an ordinary town and every town placed before it.
    "townMinSpacingTiles": 10,
    // Minimum distance (tiles) between an ordinary town and any of the five Ring Cities.
    "ringCityTownExclusionTiles": 14,
    // Ring City shops: card price multiplier, restock multiplier (applied again per restock that week), and the
    // Ring City territory pull factor (x a regular town).
    "ringShopPriceMultiplier": 2.0,
    "ringShopRestockMultiplier": 3.0,
    "ringCityPullFactor": 3.0,
    // World-gen town roads: this share of the nearest-neighbor edges is skipped (star roads never are).
    "initialTownRoadSkipFraction": 0.25,
    // World-gen: every town starts with at least one road link and never more than this many (Ring/Spawn edges uncounted).
    "townMaxRoadLinks": 5,
    // Ring Towns (the five Center Towns): an AI color may target a given Ring Town once per this many days.
    "ringTownTargetCooldownDays": 7,
    // Once a Ring Town is among a color's five nearest candidates, its pick weight is multiplied by 1 + this.
    "ringTownTargetWeightBonus": 0.25,
    // AI-vs-AI assaults: the defending AI town's guard dot fights first (table in MOD_CHANGELOG round 99).
    "aiTownGuardDefenseEnabled": true,
    // An Archmage with two lands (guard level 4) defends at Mythic power x this factor.
    "aiGuardTwoLandPowerFactor": 1.5,

    // Weighted spawn tier system, Layer 3 - per-enemy kill-decay (2026-08-23, redesigned
    // 2026-08-25 to a permanent, uncapped halving with no time recovery - no longer tunable via
    // flat scalars here; see SpawnTierWeighting.rawSpawnWeight()). The week-progression/territory
    // tables still live in their own file, "config tables/spawn_tier_weighting.json".

    // Shard cost to re-roll an Inn Tournament's draft/sealed card pool before entering
    // (2026-08-24). The new pool is drawn from the same edition-progression-gated set as
    // the original roll - re-rolling never lets you into editions you haven't unlocked.
    "innTournamentRerollShardCost": 15,

    // How many neutral ("Waste Town") POIs get pre-seeded as already-functioning (real shops,
    // no rubble) at world-gen, out of however many neutral towns end up on the map (2026-08-24
    // user request). Their shops are still gated to editions the "neutral" shard has access to,
    // same as every other unrestored neutral town's shop - see TownRestoration.
    // seedFunctioningNeutralTowns().
    // Per-color lockout on attacking the player's Capitol, in in-game days (user spec 2026-08-31:
    // "once a week... from each color"). Rolling: a dispatch on day 6 blocks that color until 13.
    // 0 disables the cooldown.
    "capitolTargetCooldownDays": 7,
    "functioningNeutralTownCount": 20,
    // Round 241 (user: "World Gen: Reduce the number of Neutral towns / Ruined towns per difficulty"). How many
    // FEWER wasteland towns a NEW world gets, by difficulty - an existing save is not touched.
    // NeutralTownCut comes off functioningNeutralTownCount above (the five star towns are never cut).
    // NeutralTownCut + RuinedTownCut is how many fewer ordinary Waste Towns are placed at all, so a cut
    // Neutral town is gone rather than left as one more ruin.
    // For scale: a world holds about 283 ordinary Waste Towns, some 260 of them ruins - so -9 ruins is
    // about 3%, where -3 of the 20 Neutral towns is 15%. Ruined cuts of about 13 / 26 / 39 would thin the
    // ruins as much as the Neutral towns. The ceiling is 57 towns in all (Neutral + Ruined): only the 60 the
    // waste biome places itself can be cut, and each of its three kinds keeps at least one.
    "worldGenNeutralTownCutEasy": 0,
    "worldGenNeutralTownCutNormal": 1,
    "worldGenNeutralTownCutHard": 2,
    "worldGenNeutralTownCutInsane": 3,
    "worldGenRuinedTownCutEasy": 0,
    "worldGenRuinedTownCutNormal": 3,
    "worldGenRuinedTownCutHard": 6,
    "worldGenRuinedTownCutInsane": 9,

    // Roaming-spawn duplicate limiting (user report 2026-09-01: three Khenra Warriors standing
    // together). A fresh roll of an enemy that already has maxSameEnemyNearby of itself alive
    // within sameEnemyNearbyRadius world units of the player is re-rolled up to
    // sameEnemySpawnRerolls times; after that it spawns anyway, so a short biome list still
    // populates. Set maxSameEnemyNearby or sameEnemySpawnRerolls to 0 to switch the rule off
    // without touching config.json. Roaming spawns land 45-180 units out, so 220 covers the whole
    // spawn ring. Grep forge.log for "[TFR-SpawnDedupe]" to see it firing.
    "maxSameEnemyNearby": 2,
    "sameEnemyNearbyRadius": 220,
    "sameEnemySpawnRerolls": 4,

    // Torch pulse (round 124): using a Torch / Grand Torch (1 shard, the item's shardsNeeded) flares your
    // fog-of-war vision to torchPulseMultiplier x its current radius for torchPulseSeconds; tiles it touches
    // stay explored (hazed) afterwards. torchPulseMaxRadiusTiles caps the flared radius - the repaint cost
    // grows with the square of it. Grep forge.log for "[TFR-TorchPulse]".
    "torchPulseMultiplier": 3.0,
    "torchPulseSeconds": 2.0,
    "torchPulseMaxRadiusTiles": 24,

    // Looted-dungeon timer (round 128, user request): a rotatable dungeon/cave the player walks out of
    // having taken every reward pickup, while live enemies are still inside, keeps this fraction of the
    // days remaining on its despawn timer - 0.5 = cut in half. Applied once per visible lifetime, and
    // never to a dungeon an active quest points at. Set to 1.0 to switch the rule off. Grep forge.log
    // for "[TFR-DungeonLooted]".
    "dungeonLootedDespawnFactor": 0.5,

    // Enemy size by tier (round 178, user decision: one size per rank, so the size tells you the rank).
    // Every non-boss enemy's "scale" in world/enemies.json draws its BODY at the hero's body size
    // (dev-tools/enemy_scale.py - the body box ignores thin swords, tails and staffs), and these four
    // multiply straight on top: Apprentice 13 / Adept 16 (the hero) / Master 20 / Archmage 24 px.
    // A rat and a dragon of the same rank are the same size. Bosses keep their hand-set sizes. The
    // roaming guards get the same cue. Collision boxes move with the art, as they always have.
    "enemyTierScaleCommon": 0.8125,
    "enemyTierScaleUncommon": 1.0,
    "enemyTierScaleRare": 1.25,
    "enemyTierScaleMythic": 1.5,

    // Round 177 (user request): losing a duel costs a FLAT amount of the gold you carry - or all of it when you
    // have less. Replaces the difficulty's percentage (config.json "goldLoss", still the fallback when a value
    // here is 0). A Bronze Coin handed over on the ante prompt still waives it. Applies to existing characters.
    "defeatGoldLossEasy": 50,
    "defeatGoldLossNormal": 100,
    "defeatGoldLossHard": 150,
    "defeatGoldLossInsane": 200,

    // Round 216 (user spec): the Coin Challenge entry fee at the Capitol's Level 2 Arena - "For 50g
    // (Easy/Normal) 100g (Hard/Insane) you can duel this enemy to try and get your coin back". The
    // duel carries no ante and waives the defeat gold penalty, so this fee is the entire cost of a
    // losing attempt. One attempt per opponent per week.
    "coinChallengeFeeEasy": 50,
    "coinChallengeFeeNormal": 50,
    "coinChallengeFeeHard": 100,
    "coinChallengeFeeInsane": 100,
    // Round 241 (user: "Up 'coin duel' cost, Easy, no change. Normal +5 Shards, Hard +10 shards, Insane +15
    // shards"). Shards charged ON TOP of the gold fee above, per attempt. 0 = gold only.
    "coinChallengeShardFeeEasy": 0,
    "coinChallengeShardFeeNormal": 5,
    "coinChallengeShardFeeHard": 10,
    "coinChallengeShardFeeInsane": 15,

    // Round 185 (user, after one duel paid FOUR Oblivion Rings and the next three Angels of Light: "It's okay to
    // sometimes get duplicate reward cards, but 4 seems extreme. Is there a way we can at least lower duplicate
    // probability?"). Extra draws a card reward gets whenever a pick repeats a name already in that same reward.
    // Duplicates stay possible - just much rarer, since each reroll multiplies the repeat chance by itself.
    // Raise for fewer duplicates; 0 restores the old draw-with-replacement behaviour.
    "rewardDuplicateRerolls": 2,

    // Round 190 (user: "currently normal arena is a 50/50 chance for AI vs. AI. Let's make that 60/40 for the
    // higher ranked opponent"). How often the higher-TIER side wins an AI-vs-AI match in an arena bracket.
    // Applies only when the two differ in tier - an equal-tier pairing keeps the original roll weighted by life
    // (lifeLeft / (lifeLeft + lifeRight)), which is where the "50/50" impression came from: it was never a flat
    // coin flip, but two same-tier arena foes usually have similar life. 50 disables the rule entirely.
    "arenaHigherTierWinPercent": 60,

    // Round 197 (user: "the 5 AI's have a capitol each. I want those to act the same way an AI town would
    // spread. But max distance be 2x that of a regular town"). Multiplier on townMaxTerritoryRadius for an AI
    // color's own "<Noun> Capital". Those five are world-gen TOWNS that never expanded at all before this round -
    // town growth needs a per-town radius entry and that was only ever seeded when a mage CAPTURED a town, so the
    // originals sat inert while their color's Castle did all the spreading. They now grow like any AI town, to
    // this multiple of the ordinary cap (still clamped to maxTerritoryRadius). 1 = an ordinary town again.
    // The inviolable core is unaffected: it has its own townProtectedRadiusCap, so the wider disc stays
    // contestable ground rather than becoming a bigger no-go zone.
    "aiCapitalTerritoryRadiusFactor": 2,

    // Round 202 (user, with a screenshot of FIVE copies of Befoul from one duel). Hard cap on copies of one card
    // name in a single reward payout. rewardDuplicateRerolls makes a repeat unlikely; this makes a PILE of them
    // impossible, which rerolling cannot do on its own - that duel's legal pool held exactly ONE distinct name
    // (an all-Kamigawa enemy deck against unlocked black editions containing neither CHK nor BOK, so only Befoul
    // had a legal reprint). When the cap bites the reward pays FEWER cards rather than another copy.
    // 0 disables the cap.
    "rewardMaxCopiesPerName": 2,

    // Round 203 (user: "relax the rarity filter when the deck can't satisfy it. If it still fails, Let's give
    // 50g per failed card"). Gold per card a "deckCard" reward promised but could not legally pay, AFTER the
    // rarity filter was already relaxed - which by then means the enemy's whole deck sits in editions this
    // colour has not unlocked yet. Also covers a card skipped by rewardMaxCopiesPerName above.
    // 50 is a Common's shop price; the median enemy gold reward is also 50, so lower this to 25 if short
    // payouts turn out to be common in play. 0 disables the fallback (the reward just pays fewer cards).
    "deckCardFallbackGold": 50,

    // Round 237 - THE CARD BUDGET (user: "cut down on the number of cards ... enemy rank to matter more ...
    // defeating an enemy for the first time should count more than a repeat win"). How many CARDS a defeated
    // roaming or dungeon enemy pays. Its own reward list still decides what can drop; the budget keeps this
    // many of them - Master and Archmage keep their best rarities first, Apprentice and Adept keep random ones,
    // and a FIRST win keeps the best first at any rank - and tops a short list up from the enemy's deck.
    // Before this: 4.4 cards per win on average on Insane. With these values: 1.8 on a repeat win, 3.1 on a
    // first win. Gold, shards, items, the ante card, bosses, arena/event fighters and a map's own extras on one
    // enemy are not budgeted. Common = Apprentice, Uncommon = Adept, Rare = Master, Mythic = Archmage.
    // Round 241: each of the eight counts below may be 1 to 5. A value outside that range is pulled back into
    // it (and logged once as [TFR-CardBudget]); gear and the Easy bonus are added on top afterwards.
    "cardBudgetEnabled": true,
    "cardBudgetRepeatCommon": 1,
    "cardBudgetRepeatUncommon": 2,
    "cardBudgetRepeatRare": 2,
    "cardBudgetRepeatMythic": 3,
    "cardBudgetFirstCommon": 2,
    "cardBudgetFirstUncommon": 3,
    "cardBudgetFirstRare": 4,
    "cardBudgetFirstMythic": 5,
    // First win only: this many extra NON-LAND cards from the enemy's deck, on top of the budget - Common or
    // Uncommon on Normal/Hard/Insane, Common/Uncommon/Rare on Easy. 0 turns it off.
    "cardBudgetFirstWinBonusCards": 1,
    // Extra cards per win on Easy (the old random extras no longer separate the difficulties).
    "cardBudgetEasyBonus": 1,
    // Rarity of a TOP-UP card (drawn from the enemy's deck when its list rolled fewer cards than the budget -
    // the reason some enemies pay more than they used to). Relative weights, Common-heavy by the user's wish;
    // Mythic is never rolled. Gear that adds reward cards is left as it was: it raises the budget in full.
    "cardBudgetTopUpWeightCommon": 80,
    "cardBudgetTopUpWeightUncommon": 17,
    "cardBudgetTopUpWeightRare": 3,

    // Round 241 - THE RESOURCE PURSE (user: "I want Green to drop more wood, Red more Stone, White more gold,
    // Blue more Shards, black be balanced. Neutral will also be balanced, but just less than black"). What a
    // defeated roaming or dungeon enemy pays in gold / shards / wood / stone. It REPLACES the gold and shards
    // entries of the enemy's own reward list, and the old rule that turned a quarter of all duel gold into wood
    // or stone. Bosses, arena/event fighters, a map's own extras on one enemy, chests and quest rewards are not
    // touched. false = everything pays as it did before round 241.
    "resourcePurseEnabled": true,
    // BASE PURSE PER RANK, in gold-equivalent value (Common = Apprentice, Uncommon = Adept, Rare = Master,
    // Mythic = Archmage). About what a win was worth before, so total income stays level.
    "resourcePurseCommon": 60,
    "resourcePurseUncommon": 90,
    "resourcePurseRare": 130,
    "resourcePurseMythic": 160,
    // This share of the purse is always paid as gold. The rest is ONE bonus resource, rolled on the enemy's color.
    "resourcePurseGoldShare": 0.35,
    // Gold value of one wood / stone / shard when the bonus is paid in them (the Exchange buys 5 for 80).
    "resourcePurseUnitValue": 16,
    // The bonus roll. A color's own resource - White gold, Blue shards, Red stone, Green wood - gets the
    // Favored weight and each of the other three the Other weight (55 / 15 / 15 / 15). Black and colorless are
    // balanced (25 each); an enemy of several colors uses the average of its colors.
    "resourcePurseFavoredWeight": 55,
    "resourcePurseOtherWeight": 15,
    // A colorless enemy's purse is this much of the full one.
    "resourcePurseColorlessFactor": 0.7,
    // The first win over an enemy pays this much more - the card budget's rule, for resources.
    "resourcePurseFirstWinFactor": 1.5,
    // Luck: every purse is multiplied by a random 1 +- this. 0 pays identical amounts every time.
    "resourcePurseVariance": 0.2,
    // Difficulty.
    "resourcePurseFactorEasy": 1.5,
    "resourcePurseFactorNormal": 1.25,
    "resourcePurseFactorHard": 1,
    "resourcePurseFactorInsane": 0.8,

    // Round 205 (user: "Town/Capitol reputation in player towns each reputation point should add 1% town/capitol
    // defense when warding off mage attacks"). Defense per point of a player town's OWN reputation against an
    // attacking war mage - subtracted from the attacker's capture chance for a town, and for the Capitol (which
    // forces a duel instead of rolling) the chance the mage is turned away before that duel.
    // The cap matters: reputation is unbounded, so 1%/point uncapped would make a long-held town immune. 20 is
    // the same ceiling shop prices already use. At the cap a Mythic mage's 90% becomes 70%.
    // The two zeroes mean OPPOSITE things: 0 in ...PerPoint disables the mechanic; 0 in ...MaxPoints removes the CAP.
    "townReputationDefensePerPoint": 0.01,
    "townReputationDefenseMaxPoints": 20,

    // Round 207 (user: "let's add the 5% floor on the capture roll"). The smallest chance an attacking mage is
    // ever left with against a player town, however much reputation and however many Outlooks defend it -
    // without it a Common-tier mage's 10% hits 0% at 10 reputation and the town simply cannot be taken. Also
    // caps the Capitol's pre-duel repel at 1 - this. 0 disables the floor and allows immunity again.
    "townMinCaptureChance": 0.05,

    // Round 177 (user request): the share of spawn rolls on your OWN territory drawn from the Wasteland roster
    // instead of the player roster (72 enemies against the Wasteland's 305) - "slightly lesser" than the own
    // pool's chance, so 0.4 = 40% Wasteland / 60% own. Never fired before this round (a biome-name bug).
    "playerColorlessMixChance": 0.4
}
