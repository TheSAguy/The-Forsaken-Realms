    // ============================================================================
    // The Forsaken Realms - Mirror Gear (round 1030, util/MirrorGear.java). Deleting this file turns it off.
    // A save that ticked "Mirror Gear" at its New Game (default: on for Hard and Insane; greyed out elsewhere) starts each
    // Master and Archmage seat with a copy of one gear item the player wears (itemsForOne+ worn) or two (itemsForTwo+),
    // once that rank's gate on the save's difficulty is met: Notoriety >= notoriety AND the save's whole win ratio
    // (wins / (wins + losses); draws not counted, a concession is a loss, Inn matches not in it) >= winRatio AND, where
    // the gate has one, the win ratio against that very enemy (the VS screen's record, by the enemy's name - one record
    // for all its ranks; at least minEnemyDuels duels, so a first meeting stays closed) >= enemyWinRatio.
    // Not in a boss fight, an Inn or Arena event, a town or Capitol fight, a guard's fight or Deck Tester, and never
    // while Notoriety is off in Settings.
    //
    // gates           rank -> difficulty name -> {notoriety, winRatio, enemyWinRatio (optional)}; a rank or a
    //                 difficulty not listed has no Mirror Gear (the New Game checkbox is greyed out on a difficulty no
    //                 rank lists)
    // minEnemyDuels   the fewest duels against an enemy before its record can open a gate with enemyWinRatio
    // gearSlots       the slots that count as worn gear (runes, staffs, Medals, Hearts, Blessings, Tokens do not)
    // topBand         an item worth this much or more is "top band": two copies are never both from it
    // bountyPointsPerCopy  the Bounty's points per copy (settings.json's bountyPoints*)
    // pool            item name -> its value to the enemy in mana (the round 1030 design study's items-mirror-table.csv).
    //                 ONLY these are ever copied. Left out: items that pay Mana Shards (dead on
    //                 an enemy; the AI pays 0), fast mana (Sol Ring, the Moxen, Black Lotus, Lotus Petal), command-zone
    //                 and choice cards, handicap and map-only items, items worth 0.5 mana or less to the enemy (the
    //                 tradeoff gear that would weaken it), Cheat, Jester's Cap and Armor of Horrors. A new item joins
    //                 only when it is added here; MirrorGearTest checks every name against world/items.json.
    // ============================================================================
    "gates": {
        "Archmage": {
            "Hard": {"notoriety": 50, "winRatio": 0.85},
            "Insane": {"notoriety": 40, "winRatio": 0.75}
        },
        "Master": {
            "Hard": {"notoriety": 40, "winRatio": 0.85, "enemyWinRatio": 0.75},
            "Insane": {"notoriety": 20, "winRatio": 0.75, "enemyWinRatio": 0.51}
        }
    },
    "minEnemyDuels": 1,
    "itemsForOne": 3,
